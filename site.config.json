  "claimExemptions": [
    {
      "path": "index.html",
      "kind": "paragraph",
      "unit_text": "Tendi shows patterns across the entries you saved and explains what each one is based on: the counts behind it and the exact dates it covers. When a pattern includes a comparison, that comparison is not a cause-and-effect claim, and Tendi does not diagnose you or tell you what to do next.",
      "expected_count": 1,
      "family": "A3",
      "justification": "Required non-causality statement"
    },
    {
      "path": "AGENTS.md",
      "kind": "list_item",
      "unit_text": "- Tendi is a self-reflection and journaling tool, not a medical, diagnostic, therapy, medication, or crisis-response product.",
      "expected_count": 1,
      "family": "A2",
      "justification": "Explicit prohibition statement in contributor guidance; it must name what it forbids. Mirrors the app contract's own AGENTS.md exemptions."
    }
  ],
